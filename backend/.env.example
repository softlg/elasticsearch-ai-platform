# ===================== Elasticsearch 配置 =====================
# 你的 ES 集群地址（多个用逗号分隔）
ES_HOSTS=http://localhost:9200
# 若启用安全认证，填写用户名/密码（关闭可留空）
ES_USERNAME=
ES_PASSWORD=
# 是否使用 https（自签证书时可关闭校验）
ES_USE_SSL=false
ES_VERIFY_CERTS=false
# 查询默认超时（秒）
ES_REQUEST_TIMEOUT=30
# 单次查询返回最大条数上限
ES_MAX_SIZE=1000

# ===================== 大模型 (OpenAI 兼容) 配置 =====================
# provider 名称：openai / deepseek / tongyi / newapi / 自定义
LLM_PROVIDER=openai
# API Key
LLM_API_KEY=sk-your-key-here
# 模型名称
LLM_MODEL=gpt-4o-mini
# 兼容接口 Base URL（newapi / DeepSeek / 通义 等都可填这里）
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# newapi:  http://your-newapi-host/v1
LLM_BASE_URL=https://api.openai.com/v1
# 调用超时（秒）
LLM_TIMEOUT=60
# 温度
LLM_TEMPERATURE=0.2
# 是否走 /responses 通道（默认 false 走标准 chat/completions）。
# 当网关的模型仅支持 /responses（如 newapi 的 codex channel，不支持 chat/completions）时，设为 true。
LLM_USE_RESPONSES=false

# ===================== 服务配置 =====================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 允许的前端跨域来源（开发用 *，生产请改为具体域名）
CORS_ORIGINS=*


